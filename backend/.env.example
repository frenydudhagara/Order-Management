# Copy to .env for local development. Every value below is already the default,
# so the app runs with no .env file at all.
#
# !! THIS FILE IS COMMITTED TO GIT (.gitignore excludes .env but keeps this one).
#    It holds placeholders only. Real passwords and connection strings go in
#    `.env`, which is never committed.

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# SQLite locally: zero setup, and the file is created and seeded on first boot.
#
# Supabase Postgres in production. Paste the string from the dashboard verbatim
# -- a `postgres://` prefix is rewritten to the psycopg driver automatically.
#
# Use the SESSION POOLER string (Connect -> Session pooler), not the direct
# connection. Two reasons:
#   * Direct connections (db.<ref>.supabase.co) are IPv6-only, and most hosts
#     including Render's free tier are IPv4-only -- it fails to resolve.
#   * Session mode keeps one backend per connection, which is what a
#     long-running server with its own pool wants.
# The transaction pooler on port 6543 also works; the app detects it and
# disables prepared statements accordingly.
#
# Substitute the password WITHOUT the surrounding square brackets -- those are
# the dashboard's placeholder markers, and are reserved characters in a URL.
#
#   DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./orders.db

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. Never "*". Add the deployed frontend origin here
# in production; browser requests fail CORS until it matches exactly, scheme
# and all, and with no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Order status simulation ----------------------------------------------
# Seconds an order sits in each status before advancing. Short for demos;
# raise it to something realistic in production.
STATUS_STEP_SECONDS=12
SIMULATOR_TICK_SECONDS=1
ENABLE_STATUS_SIMULATOR=true

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_ITEMS_PER_ORDER=50
MAX_QUANTITY_PER_ITEM=20
