# Copy to .env.local for local development.
#
# Leave VITE_API_BASE_URL unset in development: requests then go to /api on the
# dev server's own origin and Vite proxies them to http://127.0.0.1:8000, so dev
# and production share the same same-origin request code.
#
# Set it at build time in production, where the API lives on another host:
# VITE_API_BASE_URL=https://forkful-api.onrender.com
VITE_API_BASE_URL=
